; ──────────────────────────────────────────────────────────────────────────
; 50.168.192.zone — Zona inversa para 192.168.50.0/24
; Parcial 1 · Servicios Telemáticos 2026-02
; ──────────────────────────────────────────────────────────────────────────
$TTL 86400
@   IN  SOA ns1.empresa.local. admin.empresa.local. (
            2026090801  ; Serial
            3600        ; Refresh
            1800        ; Retry
            604800      ; Expire
            86400 )     ; Negative TTL

; ── Servidores de nombres ─────────────────────────────────────────────────
@       IN  NS   ns1.empresa.local.
@       IN  NS   ns2.empresa.local.

; ── Registros PTR (resolución inversa) ───────────────────────────────────
10      IN  PTR  ns1.empresa.local.     ; 192.168.50.10
11      IN  PTR  ns2.empresa.local.     ; 192.168.50.11
